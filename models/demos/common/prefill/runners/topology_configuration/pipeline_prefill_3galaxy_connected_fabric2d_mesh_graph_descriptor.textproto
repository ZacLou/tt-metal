# Three Blackhole Galaxies in a line, FABRIC_2D. Modelled on the 4-galaxy fabric2d descriptor; the
# only difference is three mesh instances and two inter-mesh connections instead of four and three.
#
# Written for Kimi-K3, which needs three ranks for a memory reason rather than a throughput one: at
# ~777 MB/chip/layer a rank tops out near 44 of the 34.2 GB/chip, so 93 layers over two ranks (46.5
# each) OOMs during weight loading. Three ranks is ~31 layers each.
#
# The inter-mesh connections are a LINE (0-1-2), which is what the physical topology discovery
# reports for these three machines: intermesh degree histogram {1:2, 2:1}, i.e. two endpoints and one
# middle. Pass the --host slots in cabling order; the middle host must be the middle mesh.
#
# dim_types [RING, RING] describes how these galaxies are PHYSICALLY cabled — both axes wrap, which
# topology discovery confirms as intra-mesh degrees {4:24, 5:8}; a LINE descriptor reports {2:4, 3:16,
# 4:12} and is rejected. What the model actually runs on is chosen separately by
# PREFILL_FABRIC_MODE=2d in the rank binding, which configures linear routing over the wrapped
# wiring. That distinction matters here: Kimi-K3 must not run with Ring routing, because
# attn_res_gather_softmax deadlocks under Topology::Ring (tenstorrent/tt-metal#54835).
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 8, 4 ] dim_types: [ RING, RING ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

graph_descriptors {
  name: "G0"
  type: "FABRIC"
  instances { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
  instances { mesh { mesh_descriptor: "M0" mesh_id: 2 } }

  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
    channels { count: 2 policy: RELAXED }
  }
  connections {
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 1 } }
    nodes { mesh { mesh_descriptor: "M0" mesh_id: 2 } }
    channels { count: 2 policy: RELAXED }
  }
}

top_level_instance { graph { graph_descriptor: "G0" graph_id: 0 } }
